---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import ClientList from '../../components/ClientList.astro';
import { projects, projectCities } from '../../data/projects';

const title = 'Commercial Construction Projects in Michigan | Meridian';
const description =
  'Project case studies from Meridian Construction: Aqua-Tots swim schools, NKD Pizza, Menchie’s and public-agency offices built across Michigan.';

const sectors = [
  {
    name: 'Retail',
    text: 'Store openings are tied to lease dates and selling seasons, so the schedule is everything. Retail build-outs mean display walls with blocking for fixtures, fitting rooms, stockrooms and restrooms — often under shopping-center rules about work hours and deliveries.',
    services: ['general-contracting', 'commercial-carpentry'],
  },
  {
    name: 'Office',
    text: 'Private offices, conference rooms and open workspace, with ceilings coordinated around lighting, diffusers and sprinklers. Office suites are frequently built in occupied buildings, so phasing, noise and clean, safe work areas matter as much as the finished walls.',
    services: ['general-contracting', 'design-build'],
  },
  {
    name: 'Medical',
    text: 'Exam rooms, waiting areas and support spaces where layout drives patient flow. Medical interiors call for careful attention to accessible design, sound separation between rooms and in-wall backing for equipment, cabinets and grab bars.',
    services: ['general-contracting', 'construction-management'],
  },
  {
    name: 'Food service',
    text: 'Restaurants, cafés and other food establishments combine a public dining room with a working kitchen. Finishes in back-of-house areas must stand up to cleaning and inspection, and construction has to be coordinated with kitchen equipment and opening-day inspections.',
    services: ['design-build', 'general-contracting'],
  },
  {
    name: 'Recreational',
    text: 'Fitness, entertainment and recreational facilities take heavy daily use. Durable wall and ceiling systems, hard-wearing doors and hardware, and well-built restrooms and locker areas keep the space performing long after opening day.',
    services: ['commercial-carpentry', 'construction-management'],
  },
  {
    name: 'Public sector',
    text: 'Offices for state and municipal agencies are built for the public and for heavy daily use: service counters and transaction windows, wide accessible circulation, durable finishes and restrooms that meet accessibility requirements.',
    services: ['general-contracting'],
  },
];
const sectorProjects = (name: string) => projects.filter((p) => p.sector === name);
const serviceNames: Record<string, string> = {
  'general-contracting': 'General contracting',
  'commercial-carpentry': 'Commercial carpentry',
  'design-build': 'Design/build',
  'construction-management': 'Construction management',
};
---

<Base title={title} description={description} crumbs={[{ name: 'Our Work', href: '/projects/' }]} pageType="CollectionPage">
  <PageHero
    eyebrow="Our work"
    title="Commercial projects built across Michigan"
    lede="Swim schools, restaurants, franchise shops and public-agency offices — built by Meridian as general contractor, with our own carpenters on the interiors. Several of these clients came back for location after location."
  />

  <section class="section" aria-labelledby="portfolio-title">
    <div class="container">
      <h2 class="visually-hidden" id="portfolio-title">Project case studies</h2>
      <div class="grid">
        {projects.map((p, i) => <ProjectCard project={p} eager={i < 2} />)}
      </div>
    </div>
  </section>

  <section class="section-tight tinted" aria-labelledby="where-title">
    <div class="container where">
      <div class="stack" style="--flow: var(--space-3)">
        <p class="eyebrow">Where we’ve built</p>
        <h2 class="h3" id="where-title">Projects in {projectCities.length} Michigan communities</h2>
        <p class="muted">From our office in Wixom to Lansing, Flint and Pittsfield Township.</p>
      </div>
      <ul class="where__list" role="list">
        {
          projectCities.map((c) => {
            const p = projects.find((x) => x.locations.includes(c))!;
            return (
              <li>
                <a href={`/projects/${p.slug}/`}>
                  <span>{c.replace(', MI', '')}</span>
                  <span class="mono">{p.client}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <ClientList />

  <section class="section" aria-labelledby="sectors-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Spaces we build</p>
        <h2 class="h2" id="sectors-title">What each type of space demands</h2>
      </div>
      <ol class="sectors" role="list">
        {
          sectors.map((s, i) => (
            <li class="sector" id={s.name.toLowerCase().replace(/\s+/g, '-')} data-reveal>
              <span class="mono sector__key">{String.fromCharCode(65 + i)}</span>
              <h3 class="h2 sector__name">{s.name}</h3>
              <div class="sector__body">
                <p>{s.text}</p>
                <p class="sector__links">
                  <span class="mono">Typical services:</span>{' '}
                  {s.services.map((slug, j) => (
                    <>
                      <a href={`/services/${slug}/`} class="inline">
                        {serviceNames[slug]}
                      </a>
                      {j < s.services.length - 1 && ', '}
                    </>
                  ))}
                </p>
                {sectorProjects(s.name).length > 0 && (
                  <p class="sector__links">
                    <span class="mono">Case studies:</span>{' '}
                    {sectorProjects(s.name).map((p, j, arr) => (
                      <>
                        <a href={`/projects/${p.slug}/`} class="inline">
                          {p.title}
                        </a>
                        {j < arr.length - 1 && ', '}
                      </>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand location="projects" heading="Planning a build-out?" />
</Base>

<style>
  .sectors {
    border-top: 2px solid var(--ink);
  }
  .sector {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--line);
  }
  .sector__key {
    color: var(--accent);
    font-size: var(--step--1);
    padding-top: 0.6rem;
  }
  .sector__body {
    grid-column: 2;
    display: grid;
    gap: var(--space-4);
    color: var(--ink-2);
    max-width: 42rem;
  }
  .sector__links .mono {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: var(--space-2);
  }
  @media (min-width: 60rem) {
    .sector {
      grid-template-columns: 3rem minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-6);
    }
    .sector__body {
      grid-column: 3;
      font-size: var(--step-1);
      line-height: 1.55;
    }
    .sector__links {
      font-size: var(--step-0);
    }
  }
  .grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 72rem) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
  }
  .where {
    display: grid;
    gap: var(--space-6);
  }
  .where__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    border-top: 2px solid var(--ink);
  }
  .where__list a {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-4) var(--space-3) var(--space-4) 0;
    border-bottom: 1px solid var(--line-strong);
    text-decoration: none;
    font-weight: 700;
    font-stretch: 108%;
    font-size: var(--step-1);
  }
  .where__list a:hover span:first-child {
    color: var(--accent);
  }
  .where__list .mono {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-stretch: 100%;
  }
  @media (min-width: 64rem) {
    .where {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-8);
    }
  }
</style>
