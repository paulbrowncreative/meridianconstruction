<Article
  title="Franchise Build-Out Checklist: From Signed Lease to Opening Day"
  seoTitle="Franchise Build-Out Checklist for Franchisees | Meridian"
  description="A franchisee’s build-out checklist: lease, prototype drawings, choosing a contractor, permits, construction and opening day — from a franchise contractor."
  slug="franchise-build-out-checklist"
  published="2026-10-13"
  readMinutes={7}
  toc={toc}
  ctaService="general-contracting"
  related={[
    { href: '/franchise-build-outs/', label: 'Franchise build-out contractor' },
    { href: '/projects/aqua-tots-swim-schools/', label: 'Case study: Aqua-Tots Swim Schools' },
    { href: '/projects/menchies-frozen-yogurt/', label: 'Case study: Menchie’s Frozen Yogurt' },
    { href: '/resources/tenant-improvement-process/', label: 'The tenant improvement process' },
