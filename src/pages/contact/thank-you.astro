---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
---

<Base
  title="Thank You — Estimate Request Received | Meridian Construction"
  description="Your estimate request has been received by Meridian Construction Companies."
  noindex
>
  <section class="section">
    <div class="container-narrow stack">
      <p class="eyebrow">Request received</p>
      <h1 class="h1">Thank you — your request is in.</h1>
      <p class="lede">
        We will review your project details and contact you to talk through scope, schedule and next steps. If your
        project is time-sensitive, call us at <a href={site.phone.href} class="inline">{site.phone.display}</a>.
      </p>
      <div class="btn-row">
        <a href="/services/" class="btn btn--ghost">Explore our services <Icon name="arrow" /></a>
        <a href="/" class="btn btn--ghost">Back to home</a>
      </div>
    </div>
  </section>
</Base>
