---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---

<article class="pcard">
  <a href={`/projects/${p.slug}/`} class="pcard__link">
    <div class="pcard__media">
      <Image
        src={p.cover.src}
        alt={p.cover.alt}
        widths={[480, 720, 960]}
        sizes="(min-width: 48rem) 33vw, 100vw"
        loading="lazy"
        class="pcard__img"
      />
    </div>
    <p class="pcard__meta mono">{p.sector} · {p.location}</p>
    <h3 class="pcard__title">{p.title}</h3>
  </a>
</article>

<style>
  .pcard__link {
    display: grid;
    gap: var(--space-3);
    text-decoration: none;
  }
  .pcard__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-3);
  }
  .pcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }
  .pcard__link:hover .pcard__img {
    transform: scale(1.03);
  }
  .pcard__meta {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pcard__title {
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .pcard__link:hover .pcard__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
