---
import { Picture } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props {
  project: Project;
  /** Heading level for the card title, so cards nest correctly under any section heading. */
  level?: 'h2' | 'h3';
  eager?: boolean;
}
const { project: p, level = 'h3', eager = false } = Astro.props;
const Heading = level;
---

<article class="pcard">
  <a href={`/projects/${p.slug}/`} class="pcard__link">
    <div class="pcard__media">
      <Picture
        src={p.cover.src}
        alt={p.cover.alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[480, 720, 960]}
        sizes="(min-width: 72rem) 25rem, (min-width: 48rem) 45vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="pcard__img"
      />
      <span class="pcard__tag mono">{p.sector}</span>
    </div>
    <div class="pcard__body">
      <Heading class="pcard__title">{p.title}</Heading>
      <p class="pcard__summary">{p.summary}</p>
      <p class="pcard__meta mono">{p.locations.map((l) => l.replace(', MI', '')).join(' · ')}</p>
    </div>
  </a>
</article>

<style>
  .pcard {
    height: 100%;
  }
  .pcard__link {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    text-decoration: none;
    background: var(--paper);
    border: 1px solid var(--line);
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .pcard__link:hover {
    border-color: var(--ink);
    box-shadow: var(--shadow-1);
  }
  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-3);
  }
  .pcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
  .pcard__link:hover :global(img) {
    transform: scale(1.04);
  }
  .pcard__tag {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    padding: 0.3rem 0.55rem;
    background: var(--night);
    color: var(--on-night);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pcard__body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border-top: 3px solid var(--accent);
  }
  .pcard__title {
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .pcard__link:hover .pcard__title {
    color: var(--accent);
  }
  .pcard__summary {
    color: var(--ink-2);
    font-size: var(--step--1);
  }
  .pcard__meta {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
