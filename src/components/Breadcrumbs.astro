---
import type { Crumb } from '../data/schema';
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav class="crumbs container" aria-label="Breadcrumb">
  <ol role="list">
    {
      crumbs.map((c, i) => (
        <li>
          {i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    padding-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted);
  }
  li + li::before {
    content: '/';
    color: var(--line-strong);
  }
  a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }
  a:hover {
    color: var(--accent);
  }
  [aria-current='page'] {
    color: var(--ink);
  }
</style>
