---
/**
 * Meridian's logo mark (grid panel + extruded "M", recovered from the legacy
 * site and AI-upscaled) paired with an HTML wordmark that stays crisp at
 * any size. Swap meridian-mark.png for a vector original when available.
 */
import { getImage } from 'astro:assets';
import mark from '../assets/brand/meridian-mark.png';

// Plain <img> so the decorative empty alt survives (the link carries the name).
const [x1, x2, x3] = await Promise.all([66, 132, 198].map((w) => getImage({ src: mark, width: w, format: 'webp' })));

interface Props {
  tone?: 'ink' | 'paper';
}
const { tone = 'ink' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <img
    src={x1.src}
    srcset={`${x1.src} 1x, ${x2.src} 2x, ${x3.src} 3x`}
    alt=""
    width="66"
    height="38"
    class="logo__mark"
    decoding="async"
  />
  <span class="logo__text">
    <span class="logo__name">Meridian</span>{" "}
    <span class="logo__sub">Construction Companies</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    line-height: 1;
  }
  .logo--paper {
    color: var(--on-night);
  }
  .logo__mark {
    width: auto;
    height: 2.35rem;
    flex: none;
    border-radius: 2px;
  }
  .logo--paper .logo__mark {
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.25);
  }
  .logo__text {
    display: grid;
    gap: 0.25rem;
  }
  .logo__name {
    font-weight: 800;
    font-stretch: 122%;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .logo__name,
  .logo__sub {
    white-space: nowrap;
  }
  .logo__sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>
