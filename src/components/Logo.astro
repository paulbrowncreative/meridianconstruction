---
/**
 * Typographic wordmark. No official logo file was available; replace this
 * component's markup with the supplied logo SVG when it is provided.
 */
interface Props {
  tone?: 'ink' | 'paper';
}
const { tone = 'ink' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="2.5"></circle>
    <path d="M20 1v38" stroke="var(--logo-accent)" stroke-width="2.5"></path>
    <path d="M9 27V14l5.5 8 5.5-8 5.5 8 5.5-8v13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="miter"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Meridian</span>
    <span class="logo__sub">Construction Companies</span>
  </span>
</span>

<style>
  .logo {
    --logo-accent: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    line-height: 1;
  }
  .logo--paper {
    --logo-accent: var(--accent-on-night);
    color: var(--on-night);
  }
  .logo__mark {
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
  }
  .logo__text {
    display: grid;
    gap: 0.25rem;
  }
  .logo__name {
    font-weight: 800;
    font-stretch: 122%;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .logo__sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>
