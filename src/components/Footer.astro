---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label={`${site.name} — home`} class="site-footer__logo"><Logo tone="paper" /></a>
        <p class="muted">
          Commercial general contracting, carpentry, design/build and construction management from Wixom,
          Michigan.
        </p>
      </div>

      <nav aria-label="Services" class="site-footer__col">
        <h2 class="site-footer__heading mono">Services</h2>
        <ul role="list">
          {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Company" class="site-footer__col">
        <h2 class="site-footer__heading mono">Company</h2>
        <ul role="list">
          <li><a href="/services/">All services</a></li>
          <li><a href="/projects/">Our work</a></li>
          <li><a href="/about/">About Meridian</a></li>
          <li><a href="/contact/">Request an estimate</a></li>
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__heading mono">Office</h2>
        <address>
          <p>
            {site.address.street}<br />
            {site.address.city}, {`${site.address.region} ${site.address.postalCode}`}
          </p>
          <p>
            <a href={site.phone.href} class="site-footer__phone" data-track="click_to_call" data-track-location="footer">
              <Icon name="phone" />
              {site.phone.display}
            </a>
          </p>
          {
            site.email && (
              <p>
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </p>
            )
          }
          {site.hours && <p class="muted">{site.hours}</p>}
        </address>
        <a href={site.directionsUrl} class="site-footer__directions" rel="noopener" target="_blank">
          Get directions <Icon name="external" /><span class="visually-hidden">(opens Google Maps in a new tab)</span>
        </a>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.legalName ?? site.name}. All rights reserved.</p>
      {site.licenseNumber && <p>License #{site.licenseNumber}</p>}
      <p><a href="/privacy/">Privacy notice</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-9) var(--space-6);
    font-size: var(--step--1);
    position: relative;
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--accent-on-night);
  }
  .site-footer__top {
    display: grid;
    gap: var(--space-7);
    padding-bottom: var(--space-8);
  }
  .site-footer__brand {
    display: grid;
    gap: var(--space-4);
    max-width: 22rem;
    font-size: var(--step-0);
  }
  .site-footer__logo {
    width: fit-content;
  }
  .site-footer__heading {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-on-night);
    margin-bottom: var(--space-4);
    font-stretch: 100%;
  }
  .site-footer ul {
    display: grid;
    gap: 0;
  }
  .site-footer__col li a,
  .site-footer__col address a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
  }
  .site-footer__col {
    font-size: var(--step-0);
  }
  address {
    font-style: normal;
    display: grid;
    gap: var(--space-2);
  }
  .site-footer__phone {
    white-space: nowrap;
    gap: var(--space-2);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .site-footer__phone :global(svg),
  .site-footer__directions :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .site-footer__directions {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    min-height: 2.25rem;
    border-bottom: 1px solid var(--night-line);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--night-line);
    color: var(--on-night-muted);
  }
  .site-footer__bottom p:last-child {
    margin-left: auto;
  }
  .site-footer__bottom a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .site-footer__top {
      grid-template-columns: repeat(3, 1fr);
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 72rem) {
    .site-footer__top {
      grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    }
    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
