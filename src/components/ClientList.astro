---
import { clients } from '../data/projects';
interface Props {
  heading?: string;
  id?: string;
}
const { heading = 'Clients we’ve built for', id = 'clients-title' } = Astro.props;
---

<section class="clients" aria-labelledby={id}>
  <div class="container clients__inner">
    <h2 class="clients__title mono" id={id}>{heading}</h2>
    <ul class="clients__list" role="list">
      {clients.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .clients {
    padding-block: var(--space-7);
    border-block: 1px solid var(--line);
  }
  .clients__inner {
    display: grid;
    gap: var(--space-5);
  }
  .clients__title {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-stretch: 100%;
    color: var(--accent);
  }
  .clients__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0;
  }
  .clients__list li {
    font-weight: 700;
    font-stretch: 108%;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--ink);
  }
  .clients__list li:not(:last-child)::after {
    content: '/';
    margin-inline: 0.65rem;
    color: var(--line-strong);
    font-weight: 400;
  }
  @media (max-width: 47.99rem) {
    .clients__list li {
      font-size: var(--step-0);
    }
  }
  @media (min-width: 64rem) {
    .clients__inner {
      grid-template-columns: 12rem 1fr;
      align-items: baseline;
    }
  }
</style>
